    "stylesheetText": "/* MPC-HC (K-Lite) dark-mode look for mpc-qt.\n   Pairs with the palette in apply-modern-theme.sh. */\n* {\n    font-family: \"Noto Sans\";\n    font-size: 9pt;\n}\n\n/* ---------- Menu bar / menus ---------- */\nQMenuBar {\n    background-color: #202020;\n    color: #d4d4d4;\n    padding: 0px;\n}\nQMenuBar::item {\n    padding: 3px 7px;\n    background: transparent;\n}\nQMenuBar::item:selected { background-color: #3a3a3a; }\nQMenu {\n    background-color: #2b2b2b;\n    color: #d4d4d4;\n    border: 1px solid #3c3c3c;\n    padding: 2px;\n}\nQMenu::item { padding: 4px 24px 4px 22px; }\nQMenu::item:selected { background-color: #3f3f3f; color: #ffffff; }\nQMenu::item:disabled { color: #6e6e6e; }\nQMenu::separator { height: 1px; background: #3c3c3c; margin: 3px 6px; }\n\n/* ---------- Controls ---------- */\n#controlSection {\n    background-color: #282828;\n    border: none;\n    padding: 0px;\n}\n#controlbar QPushButton {\n    qproperty-iconSize: 16px 16px;\n    min-width: 26px;\n    min-height: 24px;\n    padding: 2px;\n    margin: 2px 3px;\n    background-color: transparent;\n    border: 1px solid transparent;\n    border-radius: 3px;\n}\n#controlbar QPushButton:hover         { background-color: #4a4a4a; border-color: #5e5e5e; }\n#controlbar QPushButton:checked       { background-color: #353535; border-color: #474747; }\n#controlbar QPushButton:checked:hover { background-color: #505050; border-color: #646464; }\n#controlbar QPushButton:pressed       { background-color: #5a5a5a; border-color: #6e6e6e; }\n\n/* ---------- Status bar ---------- */\n#statusbar {\n    background-color: #000000;\n}\n#statusbar QLabel {\n    color: #c8c8c8;\n    padding: 2px 6px;\n}\n\n/* ---------- Playlist / panels ---------- */\nQDockWidget { color: #d4d4d4; }\nQDockWidget::title { background-color: #202020; padding: 4px; }\nQListView, QTreeView, QTableView, QListWidget {\n    background-color: #1e1e1e;\n    alternate-background-color: #232323;\n    border: 1px solid #333333;\n    selection-background-color: #3a99c7;\n    selection-color: #ffffff;\n}\nQHeaderView::section {\n    background-color: #2b2b2b;\n    color: #bdbdbd;\n    border: none;\n    border-right: 1px solid #383838;\n    padding: 4px;\n}\nQTabBar::tab {\n    background: #282828;\n    color: #bdbdbd;\n    padding: 4px 10px;\n    border: 1px solid #383838;\n    border-bottom: none;\n}\nQTabBar::tab:selected { background: #333333; color: #ffffff; }\n\n/* ---------- Inputs ---------- */\nQLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {\n    background-color: #1e1e1e;\n    border: 1px solid #3c3c3c;\n    padding: 3px 5px;\n}\nQLineEdit:focus, QComboBox:focus { border-color: #3a99c7; }\n\n/* ---------- Scrollbars ---------- */\nQScrollBar:vertical { background: #202020; width: 12px; margin: 0; }\nQScrollBar::handle:vertical { background: #4a4a4a; min-height: 30px; margin: 2px; }\nQScrollBar::handle:vertical:hover { background: #5a5a5a; }\nQScrollBar:horizontal { background: #202020; height: 12px; }\nQScrollBar::handle:horizontal { background: #4a4a4a; min-width: 30px; margin: 2px; }\nQScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }\nQScrollBar::add-page, QScrollBar::sub-page { background: transparent; }\n\nQToolTip {\n    background-color: #2b2b2b;\n    color: #e0e0e0;\n    border: 1px solid #3c3c3c;\n    padding: 3px 6px;\n}\n",
